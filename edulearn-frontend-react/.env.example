# Copy to .env (or .env.production) and adjust. Both variables are OPTIONAL —
# unset, the app keeps the defaults that the current deployments rely on.
#
# Vite only exposes variables prefixed with VITE_, and it inlines them at BUILD
# time. A static site has no runtime environment, so changing either of these
# means running `npm run build` again — setting them before starting `serve`
# has no effect.
#
# .env is gitignored; .env.example is the tracked reference.


# ---- VITE_API_ORIGIN — where the browser sends API calls ----
#
# Wins over every built-in rule in src/lib/api.ts. Set it to point a build at
# any backend without editing code.
#
# Leave it UNSET to keep the per-host defaults:
#   localhost           -> the dev server itself, proxied by vite.config.ts
#   *.vercel.app        -> /backend-api  (rewritten to the backend by Vercel)
#   https://bestbrainplus.com -> https://api.bestbrainplus.com
#   anything else       -> http://65.2.183.7   (the EC2 frontend box uses this)
#
# No trailing slash. Must be https:// if the site itself is served over https,
# or the browser blocks the call as mixed content.
#
# VITE_API_ORIGIN=https://api.bestbrainplus.com


# ---- VITE_API_TARGET — dev proxy target (dev only) ----
#
# Used by vite.config.ts to proxy /api, /backend-api, /uploads and /socket.io
# during `npm run dev`, so local calls stay same-origin and never have to
# satisfy the production CORS allowlist. Ignored in a production build.
#
# Defaults to http://65.2.183.7. Point it at a locally running backend when
# working on both halves at once.
#
# VITE_API_TARGET=http://localhost:5000
