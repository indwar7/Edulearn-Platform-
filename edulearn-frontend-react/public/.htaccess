# SPA routing for Apache / LiteSpeed hosting (Hostinger serves bestbrainplus.com).
#
# Only /index.html exists on disk. Every route under it — /login, /dashboard,
# /learn, /pal … — is resolved in the browser by React Router. Clicking through
# from / therefore works, but a hard load or a refresh of one of those URLs is a
# real request to this server, which has no such file and answers 404. That is
# why /login 404s on a phone (opened directly or reloaded) while it looks fine
# on a desktop you navigated through.
#
# Vercel did this with the rewrite in edulearn-frontend-react/vercel.json; this
# is the same rule for Apache-style hosting, and both need to stay in step.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # API traffic must never be answered with the SPA shell. Leaving these paths
  # untouched keeps them free for a proxy rule; without this the rule below
  # would hand back index.html and the app would fail parsing HTML as JSON
  # ("Unexpected token '<'") instead of reporting a clear network error.
  RewriteRule ^(backend-api|api|uploads|socket\.io)/ - [L]

  # Real files and directories (hashed assets, css, js, images) serve as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a client-side route: hand it the app shell.
  RewriteRule ^ index.html [L]
</IfModule>

# index.html must never be cached, or a browser keeps loading an old shell that
# points at asset filenames the last deploy removed. The assets themselves are
# content-hashed by Vite, so they are safe to cache indefinitely.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
